<Application x:Class="SharedMailbox.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SharedMailbox.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        StartupUri intentionally removed. App.xaml.cs builds the Generic Host
        first (so DI / config / logging are ready) and then resolves MainWindow
        from the service provider and shows it explicitly.

        Application resources merge WPF-UI's theme + control dictionaries so
        ui:FluentWindow, ui:Button, ui:TextBox, ui:InfoBar etc. resolve their
        styles. Theme is hard-coded to Light for v1; flip to "Dark" here or
        wire ApplicationThemeManager.Apply(...) in App.xaml.cs to follow
        the OS theme.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
