<UserControl x:Class="SharedMailbox.App.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="700">
    <!--
        Audit tab content. DataContext is set by the parent (MainWindow) via
        DataContext="{Binding Audit}" so the view binds to an AuditViewModel.

        Layout (top to bottom):
          1. Title + description
          2. Scope radio buttons + mailbox dropdown + IncludeSendAs checkbox
          3. Run / Cancel buttons + progress bar + status text
          4. Results DataGrid (fills remaining space)
          5. Export-path footer with "Open folder" affordance
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Audit delegated permissions"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="#666"
                       Margin="0,4,0,0"
                       Text="Lists every FullAccess / SendAs / SendOnBehalf trustee on the selected mailboxes and flags accounts whose Entra sign-in is blocked. Results auto-export to CSV."/>
        </StackPanel>

        <!-- Options -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Scope" FontWeight="SemiBold" Margin="0,0,0,4"/>

            <RadioButton GroupName="AuditScope"
                         Content="All shared mailboxes in the selected group"
                         IsChecked="{Binding IsAllInGroupScope, Mode=TwoWay}"
                         Margin="0,2"/>
            <RadioButton GroupName="AuditScope"
                         Content="Single mailbox"
                         IsChecked="{Binding IsSingleMailboxScope, Mode=TwoWay}"
                         Margin="0,2"/>

            <ComboBox ItemsSource="{Binding AvailableMailboxes}"
                      SelectedItem="{Binding SelectedMailbox}"
                      DisplayMemberPath="UserPrincipalName"
                      Margin="22,4,0,0"
                      HorizontalAlignment="Left"
                      MinWidth="320"
                      Visibility="{Binding IsSingleMailboxScope, Converter={StaticResource BoolToVisibility}}"/>

            <CheckBox Content="Include SendAs permissions"
                      IsChecked="{Binding IncludeSendAs}"
                      Margin="0,16,0,0"/>
        </StackPanel>

        <!-- Run / Cancel + progress -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <ui:Button Content="Run audit"
                       Command="{Binding RunAuditCommand}"
                       Appearance="Primary"
                       Width="140" Height="36"/>

            <ui:Button Content="Cancel"
                       Command="{Binding RunAuditCancelCommand}"
                       Width="100" Height="36"
                       Margin="8,0,0,0"
                       Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"/>

            <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                         Maximum="1"
                         Width="220" Height="6"
                         VerticalAlignment="Center"
                         Margin="16,0,0,0"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"/>

            <TextBlock Text="{Binding ProgressStatus}"
                       VerticalAlignment="Center"
                       Foreground="#666"
                       Margin="12,0,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Results -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Results}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeight="28"
                  AlternatingRowBackground="#F7F7F7">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mailbox"      Binding="{Binding Mailbox}"      Width="2*"/>
                <DataGridTextColumn Header="Trustee"      Binding="{Binding Trustee}"      Width="2*"/>
                <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}"  Width="2*"/>
                <DataGridCheckBoxColumn Header="Blocked"      Binding="{Binding SignInBlocked}"  Width="80"/>
                <DataGridCheckBoxColumn Header="FullAccess"   Binding="{Binding FullAccess}"     Width="90"/>
                <DataGridCheckBoxColumn Header="SendAs"       Binding="{Binding SendAs}"         Width="80"/>
                <DataGridCheckBoxColumn Header="SendOnBehalf" Binding="{Binding SendOnBehalf}"   Width="110"/>
                <DataGridTextColumn     Header="Lookup"       Binding="{Binding LookupStatus}"   Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Export footer -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasExportPath, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Saved to:"
                       Foreground="#666"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBlock Text="{Binding LastExportPath}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="500"
                       Margin="0,0,12,0"/>
            <ui:Button Content="Open folder"
                       Command="{Binding OpenExportFolderCommand}"
                       Padding="10,4"/>
        </StackPanel>
    </Grid>
</UserControl>
