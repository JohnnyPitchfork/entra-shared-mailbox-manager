# =============================================================================
# entra-shared-mailbox-manager — .gitignore
# Visual Studio / .NET 8 / WPF / MSIX project with PowerShell legacy reference.
# =============================================================================


# -----------------------------------------------------------------------------
# Visual Studio + MSBuild
# -----------------------------------------------------------------------------

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Visual Studio cache / options directory
.vs/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# JetBrains Rider
.idea/
*.sln.iml


# -----------------------------------------------------------------------------
# NuGet
# -----------------------------------------------------------------------------

*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets


# -----------------------------------------------------------------------------
# MSIX / packaging artifacts
# -----------------------------------------------------------------------------

# MSIX packaging project outputs
AppPackages/
BundleArtifacts/
*.appx
*.appxbundle
*.appxupload
*.msix
*.msixbundle
*.msixupload

# Certificate files used for local signing (never commit these)
*.pfx
*.snk

# Intune Win32 app wrapper outputs
*.intunewin


# -----------------------------------------------------------------------------
# .NET runtime / publish artifacts
# -----------------------------------------------------------------------------

# Published output folders
[Pp]ublish/
publish/

# Generated code coverage
*.coverage
*.coveragexml
coverage/
TestResults/


# -----------------------------------------------------------------------------
# Project-specific — runtime data that must never be committed
# -----------------------------------------------------------------------------

# Operational log directories produced by the legacy script and the v2 app.
# Real audit logs contain tenant UPNs, mailbox names, and remediation actions.
**/[Ll]ogs/
**/Logs/*.csv
**/Logs/*.xlsx
**/Logs/*.json

# Tenant-specific CSVs used as bulk-grant inputs (real user UPNs).
**/UsedImportFiles/
**/UsedImportFiles/*

# Tenant configuration files. These contain TenantId / ClientId and the
# Entra group → mailbox scope mapping. They are produced by the Config
# Builder and dropped onto target machines by Intune at deploy time —
# they are NOT source artifacts and must never be committed.
bootstrap-config.json
central-config.json
*.local.json
appsettings.*.local.json

# MSAL token caches (delegated auth tokens). Never commit auth state.
*.msalcache.bin
*.msalcache.bin3
msal_cache*


# -----------------------------------------------------------------------------
# Secrets / environment
# -----------------------------------------------------------------------------

# .NET User Secrets are stored outside the repo by design, but be paranoid:
secrets.json
*.secrets.json

# Environment files (occasionally used for local dev overrides)
.env
.env.local
*.env


# -----------------------------------------------------------------------------
# OS noise
# -----------------------------------------------------------------------------

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS (in case anyone clones on a Mac for inspection)
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~


# -----------------------------------------------------------------------------
# Editors
# -----------------------------------------------------------------------------

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Sublime
*.sublime-project
*.sublime-workspace
